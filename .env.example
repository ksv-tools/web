# Chép file này thành .env.local rồi điền giá trị. Để trống phần Supabase thì web chạy ở chế độ thử
# (chỉ trên máy, khi chạy npm run dev): đăng nhập giả, dữ liệu lưu ở thư mục .data/.

# Địa chỉ web khi đã đưa lên mạng, ví dụ https://congcukiemsat.vn (trên máy để trống).
SITE_URL=

# Supabase: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Khóa bí mật, chỉ dùng trên máy chủ. Không bao giờ đưa lên GitHub hay gửi cho ai.
SUPABASE_SERVICE_ROLE_KEY=

# Email quản trị (cách nhau bằng dấu phẩy): đăng nhập bằng email này là có quyền quản trị, không cần duyệt.
ADMIN_EMAILS=

# Số lượt tải mỗi ngày của một người (quản trị đổi được riêng cho từng người).
DEFAULT_DAILY_QUOTA=5
